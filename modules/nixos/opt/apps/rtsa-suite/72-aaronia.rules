# Aaronia RTSA-Suite / SPECTRAN (taken from the official tarball, setup_udev.sh)
# Aaronia
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0403", ATTR{idProduct}=="e8db", MODE="0666"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0403", ATTR{idProduct}=="e8da", MODE="0666"

# Spectran V6
SUBSYSTEM=="usb", ATTR{idVendor}=="2f72", ATTR{idProduct}=="0060", SYMLINK+="spectran-v6-%k", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="2f72", ATTR{idProduct}=="0064", SYMLINK+="spectran-v6-eco-%k", MODE="0666"

# Minicircuits
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="20ce", ATTRS{idProduct}=="0022", MODE="0666"

# AArtos Crypto Dongle
SUBSYSTEM=="usb", ATTR{idVendor}=="2f72", ATTR{idProduct}=="01a0", SYMLINK+="aartos-crypto-dongle-%k", MODE="0666"

# Aaronia License Dongle
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0471", ATTRS{idProduct}=="485e", SYMLINK+="aaronia-license-dongle-%k", MODE="0666"

# Grant access to the usbtmc kernel driver device nodes
KERNEL=="usbtmc*", MODE="0666"
